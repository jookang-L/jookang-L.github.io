# Google Apps Script 웹앱 배포 후 복사한 URL (…/exec 로 끝남)
GOOGLE_SCRIPT_WEB_APP_URL=

# feedback.gs 의 WEBHOOK_SECRET 과 동일한 값
FEEDBACK_WEBHOOK_SECRET=

# 생기부 도우미 링크 암호 게이트 (비우면 게이트 없음 — 바로 새 탭으로 열림)
GIBO_LINK_PASSWORD=

# 올인원 대시보드 — public에 exe 없이 GitHub Releases URL만 쓸 때 (Vercel)
